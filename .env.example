# PostgreSQL — local Docker or Neon (SSL required for Neon)
# DATABASE_URL=postgres://netchronicle:netchronicle@localhost:5432/netchronicle
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgres://netchronicle:netchronicle@localhost:5432/netchronicle

# API (Rust)
API_HOST=127.0.0.1
API_PORT=8080
RUST_LOG=info,netchronicle=debug

# Agent
AGENT_POLL_INTERVAL_SECS=2
AGENT_MIN_SEGMENT_SECS=3
AGENT_IGNORE_APPS=Program Manager,LockApp
AGENT_IDLE_THRESHOLD_SECS=300
AGENT_BROWSER_FEED_PORT=9477
NETWORK_SAMPLE_INTERVAL_SECS=30
SESSION_REBUILD_INTERVAL_SECS=300
RULES_REFRESH_INTERVAL_SECS=60
SESSION_IDLE_GAP_SECS=300
SESSION_MIN_DURATION_SECS=60
# Optional: set after first run (printed in agent logs)
# AGENT_USER_ID=
# DEFAULT_USER_ID=

# Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
