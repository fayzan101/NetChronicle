# PostgreSQL — local Docker or Neon (SSL required for Neon)
# DATABASE_URL=postgres://netchronicle:netchronicle@localhost:5432/netchronicle
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgres://netchronicle:netchronicle@localhost:5432/netchronicle

# API (Rust)
API_HOST=127.0.0.1
API_PORT=8080
RUST_LOG=info,netchronicle=debug

# Agent
AGENT_POLL_INTERVAL_SECS=2
AGENT_MIN_SEGMENT_SECS=3
NETWORK_SAMPLE_INTERVAL_SECS=30
# Optional: set after first run (printed in agent logs)
# AGENT_USER_ID=
# DEFAULT_USER_ID=

# Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
