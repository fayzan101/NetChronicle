# PostgreSQL — local Docker or Neon (SSL required for Neon)
# DATABASE_URL=postgres://netchronicle:netchronicle@localhost:5432/netchronicle
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgres://netchronicle:netchronicle@localhost:5432/netchronicle

# API (Rust)
API_HOST=127.0.0.1
API_PORT=8080
RUST_LOG=info,netchronicle=debug

# Agent
AGENT_POLL_INTERVAL_SECS=2
AGENT_MIN_SEGMENT_SECS=3
AGENT_IGNORE_APPS=Program Manager,LockApp
AGENT_IDLE_THRESHOLD_SECS=300
AGENT_BROWSER_FEED_PORT=9477
# Auth (Phase 7) — leave AUTH_REQUIRED=false for local single-user
# AUTH_REQUIRED=true
# AGENT_API_KEY=nck_...
# AGENT_DEVICE_ID=my-laptop
# AGENT_DEVICE_NAME=Laptop
SETTINGS_REFRESH_INTERVAL_SECS=30
NETWORK_SAMPLE_INTERVAL_SECS=30
# ICMP target + TCP fallback port (used when ping is unavailable)
NETWORK_PROBE_HOST=8.8.8.8
NETWORK_PROBE_TCP_PORT=53
NETWORK_PING_COUNT=4
# Optional bandwidth estimate (downloads ~100KB per sample when enabled)
NETWORK_BANDWIDTH_ENABLED=false
# NETWORK_BANDWIDTH_URL=https://speed.cloudflare.com/__down?bytes=100000
# NETWORK_BANDWIDTH_BYTES=100000
SESSION_REBUILD_INTERVAL_SECS=300
SESSION_REBUILD_LOOKBACK_DAYS=2
RULES_REFRESH_INTERVAL_SECS=60
SESSION_IDLE_GAP_SECS=300
SESSION_MIN_DURATION_SECS=60
# Optional: set after first run (printed in agent logs)
# AGENT_USER_ID=
# DEFAULT_USER_ID=

# Worker (sessions / reports / retention)
# WORKER_USER_ID=
WORKER_SESSION_INTERVAL_SECS=300
WORKER_REPORT_INTERVAL_SECS=900
WORKER_RETENTION_INTERVAL_SECS=3600
WORKER_REPORT_LOOKBACK_DAYS=30
RAW_EVENTS_RETENTION_DAYS=30
# WORKER_RUN_ONCE=true

# Dashboard (Angular)
# Edit apps/dashboard/src/environments/environment*.ts — default:
# apiUrl=http://localhost:8080

